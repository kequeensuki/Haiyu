<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.CloudAndroidCredentialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    CornerRadius="5"
    mc:Ignorable="d">

    <Grid Width="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidCredentialHeader')}" />
        <TextBlock
            Grid.Row="1"
            FontSize="12"
            Foreground="{ThemeResource SystemColorGrayTextBrush}"
            Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidCredentialDescription')}"
            TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Foreground="{ThemeResource SystemColorGrayTextBrush}"
                        Glyph="&#xE8EA;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SystemColorGrayTextBrush}"
                        Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidDumpTip')}" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ParseDumpCommand}"
                    Content="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidDumpParse')}" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidToken')}" />
                <TextBox
                    Height="72"
                    AcceptsReturn="False"
                    PlaceholderText="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidTokenPlaceholder')}"
                    Text="{x:Bind ViewModel.Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidUniqueId')}" />
                <TextBox Text="{x:Bind ViewModel.UniqueId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidDid')}" />
                <TextBox Text="{x:Bind ViewModel.Did, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidSdkToken')}" />
                <TextBox Text="{x:Bind ViewModel.SdkToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidDeviceModel')}" />
                <TextBox Text="{x:Bind ViewModel.DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidClientVersion')}" />
                <TextBox Text="{x:Bind ViewModel.ClientVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource SystemColorGrayTextBrush}"
            Text="{x:Bind ViewModel.TipMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="4" Margin="0,10,0,0" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Apply')}"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.ClearCommand}"
                Content="{x:Bind helper:LanguageService.GetString('WavesCloud_AndroidCredentialClear')}" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Off')}" />
        </Grid>
    </Grid>
</ContentDialog>
