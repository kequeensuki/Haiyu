<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Haiyu.Pages.Toolkits.GameDataExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Haiyu.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Haiyu.ViewModel.ToolkitsViewModel"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid Margin="10" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <controls:TitleBar
            x:Name="titleBar"
            Title="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportHeader')}"
            IsExtendsContentIntoTitleBar="True" />
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportTip')}"
                    Severity="Informational"
                    Title="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportTipTitle')}" />
                <StackPanel Spacing="12">
                    <ProgressBar
                        Height="6"
                        Maximum="100"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameDataExportModuleSelection">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Padding="14,8"
                        Command="{x:Bind ViewModel.StartExportCommand}"
                        Style="{ThemeResource TitleBarButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityReversalConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                            <TextBlock Text="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportAction')}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Padding="14,8"
                        Command="{x:Bind ViewModel.StopExportCommand}"
                        Style="{ThemeResource TitleBarButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                            <TextBlock Text="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportStop')}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Padding="14,8"
                        Command="{x:Bind ViewModel.ImportKeyCommand}"
                        Style="{ThemeResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportImportKeyTip')}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                            <TextBlock Text="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportImportKey')}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Padding="14,8"
                        Command="{x:Bind ViewModel.OpenOutputFolderCommand}"
                        Style="{ThemeResource TitleBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                            <TextBlock Text="{x:Bind helper:LanguageService.GetString('Toolkit_GameDataExportOpenFolder')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.KeyImportMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
