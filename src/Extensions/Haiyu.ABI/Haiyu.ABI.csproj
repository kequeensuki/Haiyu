<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <SignAssembly>False</SignAssembly>
    <DelaySign>False</DelaySign>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试工程访问 internal（原子写路径验证用） -->
    <InternalsVisibleTo Include="ABIRuntime.TransportTests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre728" />
	<PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <!-- 游戏数据导出:protobuf 运行时 + 编译期代码生成(AOT 安全,无反射) -->
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只有这一个 proto:只包含背包导出所需的最小 message 子集 -->
    <Protobuf Include="Protocol\WavesGameData.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Waves.Settings\Waves.Settings.csproj" />
    <ProjectReference Include="..\ABI\ABI.Models\ABI.Models.csproj" />
    <ProjectReference Include="..\ABI\ABIRuntime\ABIRuntime.csproj" />
  </ItemGroup>

  

  <ItemGroup>
    <None Update="Assets\PawnIOSetup.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
